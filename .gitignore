# --- Dependencies ---
node_modules/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
.venv/
env/

# --- Environment & secrets ---
.env
.env.local
.env.*
!.env.example
!.dev.vars.example
.dev.vars

# --- Build outputs ---
dist/
build/
out/
*.tsbuildinfo

# --- Cloudflare / Wrangler ---
.wrangler/
wrangler local_state/
cf/dist/

# --- Vercel ---
.vercel/
.vercel

# --- Runtime artifacts ---
# artifacts/*.md is deliberately NOT ignored: it is the deliverable the
# delegated agent produces. /agent/done returns an artifact_url pointing at it,
# so ignoring the file makes the whole delegation path publish nothing while
# still reporting success. The "repo hygiene" pass that added this ignore
# silently broke that feature - the workflow's `git add` started failing and,
# under `bash -e`, took step 10 down with it.
# Interim scratch formats stay ignored.
artifacts/*.json
artifacts/*.txt
!artifacts/.gitkeep

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- OS / Editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# --- Python legacy (vercel-leg) ---
vercel-leg/__pycache__/
vercel-leg/**/__pycache__/
*.egg-info/
.pytest_cache/

# D1 backups are committed by .github/workflows/d1-backup.yml on purpose.
# The audit found no backup of any kind; nightly exports are force-added here.
