{
  "name": "jarvis-sovereign",
  "private": true,
  "description": "J.A.R.V.I.S. Level 10/11 Cloudflare-native sovereignty stack",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test:safety": "npx tsx test/safety.test.ts",
    "test:moderation": "npx tsx test/moderation.test.ts",
    "test:menu": "npx tsx test/telegram_menu.test.ts",
    "test:logic": "npx tsx test/logic.test.ts",
    "test:mcp": "npx tsx test/mcp.test.ts",
    "db:migrate": "wrangler d1 migrations apply jarvis",
    "db:local": "wrangler d1 migrations apply jarvis --local",
    "test:go": "bash scripts/build_go_wasm.sh && cd gomod && go test ./...",
    "test:go:fixtures": "tsx scripts/gen_go_fixtures.ts",
    "build:go": "bash scripts/build_go_wasm.sh",
    "test:ctx": "npx tsx test/telegram_context.test.ts",
    "test:twomodel": "npx tsx test/two_model.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@modelcontextprotocol/server": "^2.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260902.1",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "wrangler": "^4.0.0"
  }
}