# Template lingkungan untuk sisi Python (Vercel / Fly / lokal dev).
# SALIN file ini menjadi .env.local untuk dev lokal — DAN JANGAN PERNAH
# commit isi nyata. Semua nilai di bawah hanya placeholder (CHANGE_ME).
#
# Nama variabel wajib mengikuti pembacaan di api/ dan utils/ (os.getenv).
# Nilai yang dicantumkan hanyalah contoh/dev; nilai produksi hidup dibaca
# dari dashboard Vercel/Fly + environment device, BUKAN dari repo ini.

# ===========================================================================
# Telegram (wajib — pintu masuk utama)
# ===========================================================================
TELEGRAM_TOKEN=CHANGE_ME
TELEGRAM_SECRET_TOKEN=CHANGE_ME
OWNER_CHAT_ID=CHANGE_ME

# ===========================================================================
# LLM provider
# ===========================================================================
# Groq (default) — token sembarang; model mengikuti GROQ_*_MODEL bila diisi
GROQ_API_KEY=CHANGE_ME
# Opsional override model (default ada di kode bila tidak diisi)
#GROQ_MODEL=llama-3.3-70b-versatile
#GROQ_VISION_MODEL=llama-3.2-90b-vision-preview
#GROQ_AUDIO_MODEL=whisper-large-v3-turbo
# Cadangan bila kuota Groq habis
#OPENROUTER_API_KEY=
#OPENROUTER_MODEL=

# ===========================================================================
# Search & tooling
# ===========================================================================
#TAVILY_API_KEY=
#BRAVE_API_KEY=
#GOOGLE_CSE_API_KEY=
#GOOGLE_CSE_CX=
#E2B_API_KEY=

# ===========================================================================
# Edge / device (opsional — diisi oleh device yang terhubung)
# ===========================================================================
#JARVIS_EDGE_HOST=
#JARVIS_EDGE_IP=
#JARVIS_EDGE_AUTH=

# ===========================================================================
# Vault / backup (harus diisi bila memakai legacy_vault/backup)
# ===========================================================================
#BACKUP_PASSPHRASE=

# ===========================================================================
# Supabase (opsional — dipakai bila mode cloud)
# ===========================================================================
#SUPABASE_URL=
#SUPABASE_KEY=
#SUPABASE_SERVICE_KEY=

# ===========================================================================
# Internal / keamanan (Production, jangan diubah kecuali tahu konsekuensinya)
# ===========================================================================
CRON_SECRET=CHANGE_ME
#DEVICE_SHARED_SECRET=
#AMPLITUDE_URL